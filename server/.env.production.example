# Copy to server/.env on the production machine. deploy/ec2-setup.sh does this and fills in the secrets.
NODE_ENV=production
PORT=5000

# Local MongoDB installed by the setup script, or a MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fleet_tracking
MONGO_URI=mongodb://127.0.0.1:27017/fleet_tracking

# Long random strings (the server refuses to start in production while these say change_me)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Public address(es) of the site, comma separated. Used for CORS and socket connections.
# With SERVE_CLIENT=true the client is on the same origin as the API, so this is your site URL.
CLIENT_URL=http://YOUR_EC2_PUBLIC_IP

# Serve the built client (client/dist) from this server: true | false | auto (serve when a build exists)
SERVE_CLIENT=true

# Set to 1 when behind Nginx or a load balancer so rate limits see the visitor's IP, not the proxy's
TRUST_PROXY=1

# Time zone used to group deliveries by day on the dashboard and reports
REPORT_TZ=Asia/Kolkata
