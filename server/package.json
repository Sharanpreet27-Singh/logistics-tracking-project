{
  "name": "fleet-tracking-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API + Socket.IO server for the Real-Time Logistics & Fleet Tracking System",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/config/initDb.js",
