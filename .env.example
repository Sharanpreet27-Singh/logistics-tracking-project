# AWS RDS connection for Docker Compose. For a native install use server/.env.
DB_HOST=
DB_PORT=3306
DB_NAME=fleet_tracking_live
DB_USER=
DB_PASSWORD=
# Path to the RDS CA bundle on the Docker host.
DB_SSL_CA_PATH=./server/certs/rds-global-bundle.pem
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
DEMO_MODE=false
